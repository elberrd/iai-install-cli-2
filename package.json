{
  "name": "impactus",
  "version": "2.0.0-alpha.5",
  "description": "impactus — the IAI installer: agent harness + FIA (the IAI Agent Factory) with Pi, deterministic FDAs and Claude/Codex subscription auth.",
  "type": "module",
  "bin": {
    "impactus": "bin/create-iai.js",
    "imp": "bin/imp.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "node test/run.mjs",
    "sync:skills": "node scripts/sync-skills.mjs",
    "sync:skills:check": "node scripts/sync-skills.mjs --check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write ."
  },
  "files": [
    "bin",
    "src",
    "fia-templates",
    "pi-templates",
    "README.md"
  ],
  "keywords": [
    "create",
    "starter",
    "scaffold",
    "installer",
    "nextjs",
    "convex",
    "clerk",
    "fia",
    "pi",
    "agent-factory"
  ],
  "author": "Impactus Academy (https://www.impactus.academy)",
  "license": "MIT",
  "homepage": "https://github.com/elberrd/iai-install-cli-2#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elberrd/iai-install-cli-2.git"
  },
  "bugs": {
    "url": "https://github.com/elberrd/iai-install-cli-2/issues"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "execa": "^9.6.0",
    "picocolors": "^1.1.1",
    "yaml": "^2.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "better-sqlite3": "^12.11.1",
    "chokidar": "^4.0.3",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "ink": "^7.0.0",
    "marked": "^15.0.12",
    "marked-terminal": "^7.3.0",
    "prettier": "^3.0.0",
    "react": "^19.2.0"
  }
}
